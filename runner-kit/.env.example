# Generate with: openssl rand -hex 32   (the same value goes into XPLO as XPLO_RUNNER_TOKEN)
RUNNER_TOKEN=
PORT=8787
BIND=127.0.0.1
TOOLS_IMAGE=xplo-tools:latest
# Leave empty to keep every session offline. Set to a firewalled Docker network that can reach ONLY your lab.
LAB_NETWORK=
MAX_SESSIONS=4
MAX_SESSION_MINUTES=60
MAX_COMMAND_SECONDS=120
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
